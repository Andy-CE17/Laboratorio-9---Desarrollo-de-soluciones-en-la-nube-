{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSoloOriginales",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REEMPLAZAR_BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["originales/", "originales/*"] } }
    },
    {
      "Sid": "GestionarImagenesOriginales",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::REEMPLAZAR_BUCKET/originales/*"
    }
  ]
}
